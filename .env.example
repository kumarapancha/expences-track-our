# MongoDB Atlas connection string (free tier is enough)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/expenses

# Password for the website login
APP_PASSWORD=change-me

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SMS_API_KEY=

# Optional: only accept SMS from these sender IDs (comma separated)
ALLOWED_SENDERS=

PORT=3000
